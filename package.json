{
  "name": "pacano",
  "version": "0.1.2",
  "description": "Tiny local Pacman mirror",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "start:compiled": "bun dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "Arch",
    "ArchLinux",
    "pacman",
    "Mirror"
  ],
  "author": "Ibrahim Rafi",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.4.5"
  }
}
